# Copy this file to .env and put your real Gemini key there.
# .env is ignored by git, so your secret will not be submitted by mistake.
GEMINI_API_KEY=put-your-gemini-api-key-here
OPENAI_API_KEY=put-your-openai-api-key-here

# Required when exposing MCP servers on the public internet.
# Use a long random value and share it only with the other group/orchestrator.
MCP_AUTH_TOKEN=put-a-long-random-token-here

# Bonus email uses Gmail OAuth token files, not passwords.
# Put credentials.json in the repo root, then the first bonus run will create:
# token_group_1_aisha.json and token_group_2_yanal.json after browser approval.
